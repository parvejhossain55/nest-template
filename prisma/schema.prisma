generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED     // temporarily restricted, can be restored
  BANNED        // permanent, requires appeal to lift
  DEACTIVATED   // user-initiated (e.g. account deletion request)
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ------------------------------------------------------------
// CORE: USERS
// ------------------------------------------------------------

model User {
  id                   String     @id @default(uuid())

  name                 String?    @map("first_name")
  avatarUrl            String?    @map("avatar_url")

  email                String     @unique
  passwordHash         String     @map("password_hash")

  role                 Role       @default(USER)
  status               UserStatus @default(ACTIVE)

  emailVerifiedAt      DateTime?  @map("email_verified_at")
  lastLoginAt          DateTime?  @map("last_login_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at") // soft delete

  // Relations
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]

  @@index([role, status])
  @@map("users")
}

// ------------------------------------------------------------
// SESSIONS: REFRESH TOKEN ROTATION
// ------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") // sha256(token) — deterministic for lookup & reuse detection
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")         // set on rotation / logout
  lastUsedAt DateTime? @map("last_used_at")       // last rotation time, aids theft detection
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// EMAIL VERIFICATION / PASSWORD RESET
// ------------------------------------------------------------

model VerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  type       TokenType

  usedAt     DateTime? @map("used_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("verification_tokens")
}

